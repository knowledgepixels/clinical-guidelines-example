@prefix this: <http://purl.org/nanopub/temp/np09/> .
@prefix sub: <http://purl.org/nanopub/temp/np09/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix orcid: <https://orcid.org/> .
@prefix cpg: <https://example.org/demo/cpg-vocab/> .
@prefix ex: <https://example.org/demo/clinical-guidance/> .
@prefix src: <https://example.org/demo/source/> .

sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  ex:recommendation-c-for-condition-a-v2 a cpg:ClinicalRecommendationVersion;
    rdfs:label "Intervention C for Condition A, as recommended in Guidance A v2.0";
    dct:isVersionOf ex:recommendation-c-for-condition-a;
    cpg:statedIn ex:guidance-a-v2;
    cpg:hasRecommendationStrength cpg:MayBeConsidered;
    cpg:recommendsIntervention ex:intervention-c;
    cpg:hasRecommendationText "Intervention C may be considered only when Criteria B1 and B2 are both present, at 10 demo-units, oral route, once daily, for up to 7 days." .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo orcid:0000-0001-8492-0354;
    prov:wasDerivedFrom <https://example.org/demo/guidance/guidance-a-2.0> .
}

sub:pubinfo {
  this: dct:created "2026-09-15T14:40:13Z"^^xsd:dateTime;
    dct:creator orcid:0000-0001-8492-0354;
    dct:license <https://creativecommons.org/licenses/by/4.0/>;
    npx:hasNanopubType npx:ExampleNanopub;
    rdfs:comment "Synthetic demonstration content. All conditions, interventions, criteria, doses and sources are fictional and illustrative. Not clinical guidance and not to be used for any clinical purpose.";
    rdfs:label "Recommendation of Intervention C for Condition A (Guidance A v2.0)";
    npx:introduces ex:recommendation-c-for-condition-a-v2 .
}
