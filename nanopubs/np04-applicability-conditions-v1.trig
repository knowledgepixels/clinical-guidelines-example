@prefix this: <http://purl.org/nanopub/temp/np04/> .
@prefix sub: <http://purl.org/nanopub/temp/np04/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix orcid: <https://orcid.org/> .
@prefix cpg: <https://example.org/demo/cpg-vocab/> .
@prefix ex: <https://example.org/demo/clinical-guidance/> .
@prefix src: <https://example.org/demo/source/> .

sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  ex:recommendation-c-for-condition-a-v1 cpg:hasApplicabilityConditions ex:applicability-conditions-v1 .

  ex:applicability-conditions-v1 a cpg:ApplicabilityConditionSet;
    rdfs:label "Criteria B met and no response to Standard Approach D";
    cpg:requiresAllOf ex:criteria-b, ex:non-response-to-standard-approach-d .

  ex:criteria-b a cpg:ClinicalCriterion;
    rdfs:label "Criteria B" .

  ex:non-response-to-standard-approach-d a cpg:ClinicalCriterion;
    rdfs:label "No response to Standard Approach D";
    cpg:refersToIntervention ex:standard-approach-d .

  ex:standard-approach-d a cpg:Intervention;
    rdfs:label "Standard Approach D" .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo orcid:0000-0001-8492-0354;
    prov:wasDerivedFrom <https://example.org/demo/guidance/guidance-a-1.0> .
}

sub:pubinfo {
  this: dct:created "2026-09-15T14:40:13Z"^^xsd:dateTime;
    dct:creator orcid:0000-0001-8492-0354;
    dct:license <https://creativecommons.org/licenses/by/4.0/>;
    npx:hasNanopubType npx:ExampleNanopub;
    rdfs:comment "Synthetic demonstration content. All conditions, interventions, criteria, doses and sources are fictional and illustrative. Not clinical guidance and not to be used for any clinical purpose.";
    rdfs:label "Applicability conditions of the Intervention C recommendation (Guidance A v1.0)";
    npx:introduces ex:applicability-conditions-v1 .
}
